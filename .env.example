# Database (matches docker-compose.yml defaults)
POSTGRES_USER=trailsense
POSTGRES_PASSWORD=trailsense
POSTGRES_DB=trailsense
DATABASE_URL=postgresql://trailsense:trailsense@localhost:5432/trailsense

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Web (Next.js requires the NEXT_PUBLIC_ prefix for browser-exposed vars)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Map basemap (MapTiler Outdoor/Topo) - get a free-tier key at https://www.maptiler.com/
NEXT_PUBLIC_MAPTILER_API_KEY=

# Geocoding (Photon or MapTiler) - used for search, not for autocomplete via public Nominatim
GEOCODING_API_KEY=
